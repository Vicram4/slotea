# Copia este archivo a .env (ignorado por Git) y pon tus propios valores.
# Lo leen docker compose (raíz) y la API de Spring (apps/api).

# --- PostgreSQL local (docker compose) ---
POSTGRES_DB=slotea
POSTGRES_USER=slotea
POSTGRES_PASSWORD=
# Cambia el puerto si el 5432 ya está ocupado en tu máquina.
POSTGRES_PORT=5432

# --- API ---
# Puerto local de la API (en Cloud Run lo fija la plataforma).
# Si lo cambias, cambia también API_URL en apps/web/.env.local.
PORT=8080

# --- Auth ---
# Clave para firmar los JWT (HS256): Base64 de al menos 32 bytes. Sin ella la API no arranca.
# Genera una propia con:  openssl rand -base64 48
JWT_SECRET=

# --- Enlaces de gestión de citas (emails) ---
# Clave HMAC: Base64 de al menos 32 bytes. Sin ella la API no arranca. Cambiarla invalida los enlaces enviados.
# Genera una propia con:  openssl rand -base64 48
LINK_SECRET=
# Web a la que apuntan los enlaces de los emails.
APP_WEB_URL=http://localhost:3000

# --- Email ---
# En local se usa Mailpit (docker compose) y no hace falta nada más. En producción: Brevo SMTP.
# MAIL_FROM=Slotea <tu-remitente@example.com>
# MAIL_HOST=
# MAIL_PORT=
# MAIL_USERNAME=
# MAIL_PASSWORD=

# --- Jobs (/internal/jobs/*, los llama un cron externo) ---
# Al menos 32 caracteres. Vacío = esos endpoints responden 401.
# Genera uno con:  openssl rand -base64 32
JOBS_TOKEN=

# --- Mailpit ---
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
