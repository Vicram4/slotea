# Copia este archivo a .env (ignorado por Git) y pon tus propios valores.
# Lo leen docker compose (raíz) y la API de Spring (apps/api).

# --- PostgreSQL local (docker compose) ---
POSTGRES_DB=slotea
POSTGRES_USER=slotea
POSTGRES_PASSWORD=
# Cambia el puerto si el 5432 ya está ocupado en tu máquina.
POSTGRES_PORT=5432

# --- API ---
# Puerto local de la API (en Cloud Run lo fija la plataforma).
# Si lo cambias, cambia también API_URL en apps/web/.env.local.
PORT=8080

# --- Auth ---
# Clave para firmar los JWT (HS256): Base64 de al menos 32 bytes. Sin ella la API no arranca.
# Genera una propia con:  openssl rand -base64 48
JWT_SECRET=

# --- Mailpit ---
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
