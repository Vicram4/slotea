  "components" : {
    "schemas" : {
      "AvailabilityResponse" : {
        "type" : "object",
        "properties" : {
          "days" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/DayAvailability"
            }
          },
          "timezone" : {
            "type" : "string"
          }
        },
        "required" : [ "days", "timezone" ]
      },
      "BookingRequest" : {
        "type" : "object",
        "properties" : {
          "customer" : {
            "$ref" : "#/components/schemas/CustomerInput"
          },
          "notes" : {
            "type" : [ "string", "null" ],
            "maxLength" : 500,
            "minLength" : 0
          },
          "serviceId" : {
            "type" : "string",
            "format" : "uuid"
          },
          "staffId" : {
            "type" : [ "string", "null" ],
            "format" : "uuid"
          },
          "startsAt" : {
            "type" : "string",
            "format" : "date-time"
          }
        },
        "required" : [ "customer", "serviceId", "startsAt" ]
      },
      "BookingResponse" : {
        "type" : "object",
        "properties" : {
          "customerEmail" : {
            "type" : "string"
          },
          "date" : {
            "type" : "string",
            "format" : "date"
          },
          "endsAt" : {
            "type" : "string",
            "format" : "date-time"
          },
          "id" : {
            "type" : "string",
            "format" : "uuid"
          },
          "serviceName" : {
            "type" : "string"
          },
          "staffName" : {
            "type" : "string"
          },
          "startsAt" : {
            "type" : "string",
            "format" : "date-time"
          },
          "time" : {
            "type" : "string",
            "example" : "10:15",
            "pattern" : "^[0-2][0-9]:[0-5][0-9]$"
          },
          "timezone" : {
            "type" : "string"
          }
        },
        "required" : [ "customerEmail", "date", "endsAt", "id", "serviceName", "staffName", "startsAt", "time", "timezone" ]
      },
      "BusinessResponse" : {
        "type" : "object",
        "properties" : {
          "contactEmail" : {
            "type" : "string"
          },
          "createdAt" : {
            "type" : "string",
            "format" : "date-time"
          },
          "demo" : {
            "type" : "boolean"
          },
          "id" : {
            "type" : "string",
            "format" : "uuid"
          },
          "name" : {
            "type" : "string"
          },
          "slug" : {
            "type" : "string"
          },
          "timezone" : {
            "type" : "string"
          }
        },
        "required" : [ "contactEmail", "createdAt", "demo", "id", "name", "slug", "timezone" ]
      },
      "ClosureRequest" : {
        "type" : "object",
        "properties" : {
          "endDate" : {
            "type" : "string",
            "format" : "date"
          },
          "reason" : {
            "type" : [ "string", "null" ],
            "maxLength" : 200,
            "minLength" : 0
          },
          "staffId" : {
            "type" : [ "string", "null" ],
            "format" : "uuid"
          },
          "startDate" : {
            "type" : "string",
            "format" : "date"
          }
        },
        "required" : [ "endDate", "startDate" ]
      },
      "ClosureResponse" : {
        "type" : "object",
        "properties" : {
          "createdAt" : {
            "type" : "string",
            "format" : "date-time"
          },
          "endDate" : {
            "type" : "string",
            "format" : "date"
          },
          "id" : {
            "type" : "string",
            "format" : "uuid"
          },
          "reason" : {
